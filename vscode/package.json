{
  "name": "deskbuddy",
  "displayName": "DeskBuddy: Animated Reminder Buddy",
  "description": "A friendly animated character in your sidebar that reminds you to drink water, take breaks and stretch while you code.",
  "version": "1.3.0",
  "publisher": "jaffersha",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "water reminder",
    "break reminder",
    "pet",
    "buddy",
    "health"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/JAFFERSHA/deskbuddy"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "deskbuddy.view",
          "name": "DeskBuddy"
        }
      ]
    },
    "commands": [
      {
        "command": "deskbuddy.remindNow",
        "title": "DeskBuddy: Try a Reminder Now",
        "icon": "$(bell)"
      },
      {
        "command": "deskbuddy.chooseCharacter",
        "title": "DeskBuddy: Choose Character",
        "icon": "$(account)"
      },
      {
        "command": "deskbuddy.chooseCharm",
        "title": "DeskBuddy: Choose Hanging Charm",
        "icon": "$(sparkle)"
      },
      {
        "command": "deskbuddy.togglePause",
        "title": "DeskBuddy: Pause or Resume Reminders (1 hour)"
      },
      {
        "command": "deskbuddy.showPro",
        "title": "DeskBuddy: Preview Pro (Coming Soon)"
      },
      {
        "command": "deskbuddy.openSettings",
        "title": "DeskBuddy: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "deskbuddy.addTimedReminder",
        "title": "DeskBuddy: Add Timed Reminder",
        "icon": "$(clock)"
      },
      {
        "command": "deskbuddy.removeTimedReminder",
        "title": "DeskBuddy: Remove Timed Reminder"
      },
      {
        "command": "deskbuddy.toggleFocus",
        "title": "DeskBuddy: Start or Stop Focus Timer",
        "icon": "$(target)"
      }
    ],
    "configuration": {
      "title": "DeskBuddy",
      "properties": {
        "deskbuddy.name": {
          "type": "string",
          "default": "friend",
          "description": "What your buddy calls you."
        },
        "deskbuddy.character": {
          "type": "string",
          "enum": [
            "mika",
            "arjun",
            "zoe",
            "capy",
            "axo",
            "boo",
            "boba",
            "ducky"
          ],
          "default": "mika",
          "description": "Which free character to show."
        },
        "deskbuddy.pet": {
          "type": "boolean",
          "default": true,
          "description": "Let the buddy stroll around the DeskBuddy view."
        },
        "deskbuddy.reminderIcon": {
          "type": "string",
          "default": "mix",
          "enum": [
            "buddy",
            "mix",
            "car",
            "scooter",
            "skate",
            "plane",
            "balloon",
            "ufo",
            "cloud",
            "rocket",
            "webby"
          ],
          "enumDescriptions": [
            "Your buddy brings the reminder",
            "A surprise each time",
            "Car",
            "Scooter",
            "Skateboard",
            "Paper plane",
            "Hot-air balloon",
            "UFO",
            "Rain cloud",
            "Rocket",
            "Webby the spider"
          ],
          "description": "Who brings your reminders: your buddy, a car, a rocket or Webby. It stays until you answer."
        },
        "deskbuddy.sound": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "chime",
            "pop",
            "themed"
          ],
          "enumDescriptions": [
            "Silent",
            "Soft chime",
            "Pop",
            "Matches the ride (honk, whoosh, ...)"
          ],
          "description": "A short sound when a reminder appears."
        },
        "deskbuddy.charm": {
          "type": "string",
          "enum": [
            "none",
            "evileye",
            "lemon",
            "mask",
            "hamsa",
            "webby",
            "luckycat",
            "duck",
            "boba",
            "pixelheart",
            "moon",
            "cactus",
            "clover",
            "disco"
          ],
          "enumDescriptions": [
            "No charm",
            "Evil eye",
            "Lemon and chilli",
            "Drishti mask",
            "Hamsa hand",
            "Webby the spider",
            "Lucky cat",
            "Rubber duck",
            "Boba tea",
            "Pixel heart",
            "Moon and stars",
            "Cactus",
            "Clover",
            "Disco ball"
          ],
          "default": "none",
          "description": "A good-luck charm that hangs from the top of the DeskBuddy view and swings when you touch it."
        },
        "deskbuddy.snoozeMinutes": {
          "type": "number",
          "enum": [
            5,
            10,
            30
          ],
          "default": 10,
          "description": "Minutes to wait after Snooze."
        },
        "deskbuddy.water.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Water reminder."
        },
        "deskbuddy.water.minutes": {
          "type": "number",
          "default": 45,
          "minimum": 1,
          "description": "Minutes between water reminders."
        },
        "deskbuddy.rest.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Break reminder."
        },
        "deskbuddy.rest.minutes": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "description": "Minutes between break reminders."
        },
        "deskbuddy.stretch.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Stretch reminder."
        },
        "deskbuddy.stretch.minutes": {
          "type": "number",
          "default": 90,
          "minimum": 1,
          "description": "Minutes between stretch reminders."
        },
        "deskbuddy.eyes.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Eye rest reminder."
        },
        "deskbuddy.eyes.minutes": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "Minutes between eye rest reminders."
        },
        "deskbuddy.custom.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Your own reminder."
        },
        "deskbuddy.custom.minutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "Minutes between custom reminders."
        },
        "deskbuddy.custom.text": {
          "type": "string",
          "default": "Your own reminder goes here.",
          "description": "Text of the custom reminder. Use {name} for your name."
        },
        "deskbuddy.schedules": {
          "type": "array",
          "default": [],
          "description": "Timed reminders. Easiest to edit with the command 'DeskBuddy: Add Timed Reminder'.",
          "items": {
            "type": "object",
            "required": [
              "text",
              "time"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "time": {
                "type": "string",
                "pattern": "^([01]?\\d|2[0-3]):[0-5]\\d$",
                "description": "24-hour time, for example 11:00"
              },
              "repeat": {
                "type": "string",
                "enum": [
                  "once",
                  "daily",
                  "weekdays"
                ],
                "default": "daily"
              },
              "warn": {
                "type": "number",
                "enum": [
                  0,
                  5,
                  10,
                  15
                ],
                "default": 0,
                "description": "Also warn this many minutes before."
              },
              "on": {
                "type": "boolean",
                "default": true
              }
            }
          }
        },
        "deskbuddy.quietHours.enabled": {
          "type": "boolean",
          "default": false,
          "description": "No repeating reminders during quiet hours. Timed reminders still come through."
        },
        "deskbuddy.quietHours.from": {
          "type": "string",
          "default": "22:00",
          "description": "Quiet hours start (24-hour time)."
        },
        "deskbuddy.quietHours.to": {
          "type": "string",
          "default": "08:00",
          "description": "Quiet hours end (24-hour time)."
        },
        "deskbuddy.dailySummary.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Show a summary of the day's check-ins."
        },
        "deskbuddy.dailySummary.time": {
          "type": "string",
          "default": "18:00",
          "description": "When to show the daily summary (24-hour time)."
        },
        "deskbuddy.focus.workMinutes": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "description": "Focus timer: minutes of work."
        },
        "deskbuddy.focus.breakMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "Focus timer: minutes of break."
        },
        "deskbuddy.animations": {
          "type": "boolean",
          "default": true,
          "description": "Play the water drop, rocket, car, spider swing, balloon and confetti animations in the DeskBuddy view."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "deskbuddy.chooseCharacter",
          "when": "view == deskbuddy.view",
          "group": "navigation@1"
        },
        {
          "command": "deskbuddy.chooseCharm",
          "when": "view == deskbuddy.view",
          "group": "navigation@2"
        },
        {
          "command": "deskbuddy.addTimedReminder",
          "when": "view == deskbuddy.view",
          "group": "navigation@3"
        },
        {
          "command": "deskbuddy.toggleFocus",
          "when": "view == deskbuddy.view",
          "group": "navigation@4"
        },
        {
          "command": "deskbuddy.openSettings",
          "when": "view == deskbuddy.view",
          "group": "navigation@5"
        },
        {
          "command": "deskbuddy.remindNow",
          "when": "view == deskbuddy.view",
          "group": "more@1"
        },
        {
          "command": "deskbuddy.removeTimedReminder",
          "when": "view == deskbuddy.view",
          "group": "more@2"
        },
        {
          "command": "deskbuddy.togglePause",
          "when": "view == deskbuddy.view",
          "group": "more@3"
        },
        {
          "command": "deskbuddy.showPro",
          "when": "view == deskbuddy.view",
          "group": "more@4"
        }
      ]
    }
  }
}
